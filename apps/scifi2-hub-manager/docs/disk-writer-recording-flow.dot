digraph disk_writer_recording {
  rankdir=LR;
  graph [bgcolor="transparent", fontname="Arial", nodesep="0.55", ranksep="0.75"];
  node [fontname="Arial", shape="box", style="rounded,filled", color="#385170", fillcolor="#F7F9FC"];
  edge [color="#385170", penwidth="1.4", arrowsize="0.7"];

  broadband [label="kBroadbandSource\nRHD2132 reference", fillcolor="#E8F1FB"];
  app [label="kApplication\nscifi2-hub-manager"];
  writer [label="kDiskWriter\nscifi2-hub-manager.hdf5", fillcolor="#EAF6EC"];

  broadband -> app [label="BroadbandFrame"];
  app -> writer [label="broadband_out\nBroadbandFrame"];
}