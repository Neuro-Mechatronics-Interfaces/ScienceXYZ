digraph calibration_data {
  rankdir=LR;
  node [shape=box];
  browser [label="Chrome: Reactions website\nRoute B only"];
  bridge [label="Terminal 3: bridge :9999\nBrowser journal"];
  app [label="Terminal 2: NDJSON :18765\n+ running device task App"];
  raw [label="C++ raw recorder\nBroadband + task taps"];
