  bridge -> app [label="Task requests"];
  app -> bridge [label="Committed events"];
  app -> raw [label="Original tap payloads"];
  bridge -> raw [label="Start / stop"];
  raw -> offline [label="Immutable HDF5"];
  bridge -> offline [label="Journal + profile"];
}
