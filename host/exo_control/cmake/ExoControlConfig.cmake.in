@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if("Core" IN_LIST ExoControl_FIND_COMPONENTS OR NOT @BUILD_SHARED_LIBS@)
  find_package(Protobuf CONFIG QUIET)
  if(NOT Protobuf_FOUND)
    find_dependency(Protobuf)
  endif()
  find_dependency(gRPC CONFIG)
  find_dependency(cppzmq CONFIG)
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ExoControlTargets.cmake")
set(ExoControl_Core_FOUND TRUE)
check_required_components(ExoControl)
